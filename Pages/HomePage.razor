@page "/HomePage"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Components
@using CoilMonitorWeb.Helpers

@inject HttpClient Http
@implements IDisposable
@inject IJSRuntime JS
@inject RequestService RequestService

<div class="dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="mb-0">Hall Monitor</h1>

        @* <div class="d-flex gap-2">

            <div class="card bg-dark text-white border-secondary">
                <div class="card-body text-center p-2" style="width:100px;height:75px;">
                    <div class="text-warning">Pending</div>
                    <h5>@PendingJobs</h5>
                </div>
            </div>

            <div class="card bg-dark text-white border-secondary">
                <div class="card-body text-center p-2" style="width:100px;height:75px;">
                    <div class="text-success">Completed</div>
                    <h5>@CompletedJobs</h5>
                </div>
            </div>

            <div class="card bg-dark text-white border-secondary">
                <div class="card-body text-center p-2" style="width:100px;height:75px;">
                    <div class="text-danger">Failed</div>
                    <h5>@FailedJobs</h5>
                </div>
            </div>

        </div> *@

        <button class="btn btn-primary" @onclick="(() => ShowRequestJobModal = true)">
            Request Job
        </button>

    </div>
    <div class="line-status-container">
        <div class="line-status">
            <span style="color:@GetStatusColor("Running")">Running: @RunCnt</span>
        </div>
        <div class="line-status">
            <span style="color:@GetStatusColor("Hung")" Title=@hungString>Hung: @HungCnt</span>
        </div>
        <div class="line-status">
            <span style="color:@GetStatusColor("Sleeping")" Title=@sleepString>Sleeping: @SleepCnt</span>
        </div>
        <div class="line-status">
            <span style="color:@GetStatusColor("Stopped")" Title=@stopString>Stopped: @StopCnt</span>
        </div>
    </div>

    @if (_dashboard == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @foreach (var service in _dashboard.Services)
        {
            <div class="dashboard-card">

                <h2>@service.Service</h2>

                @if (service.State == "Running")
                {
                    <RunningHeartbeat />
                }
                else if (service.State == "Hung")
                {
                    <HungHeartbeat />
                }
                else if (service.State == "Sleeping")
                {
                    <SleepingHeartbeat />
                }
                else
                {
                    <StoppedHeartbeat />
                }

                <p>
                    <strong>Status:</strong>
                    <span style="color:@GetStatusColor(service.State)">
                        @service.State
                    </span>
                </p>

                <p>
                    <strong>Heartbeat:</strong>
                    @* @service.HeartbeatDT *@
                    @service.HeartbeatDT.ToLocalTime().ToString("T")
                </p>

            </div>
        }
    }
</div>
@if (ShowRequestJobModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Request Job</h5>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Job Type</label>

                        <InputSelect class="form-select" @bind-Value="SelectedJobType">
                            <option value="">Select Job Type</option>

                            @foreach (var jobType in JobTypes)
                            {
                                <option value="@jobType">@jobType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Job Name</label>

                        <InputText class="form-control" @bind-Value="NewJob.JobName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Retry Count</label>

                        <InputNumber class="form-control" @bind-Value="NewJob.RetryCnt" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Notification Required
                        </label>

                        <InputSelect class="form-select" @bind-Value="NewJob.NotificationRequired">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </InputSelect>
                    </div>

                    <input style="
                            width: 100%;
                            padding: 8px;
                            margin-top: 12px;
                            margin-bottom: 16px;"
                            type="password" @bind="authToken" />

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">
                        Cancel
                    </button>

                    <button class="btn btn-primary" @onclick="SubmitJob">
                        Submit
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code
{
    #region Variables
    private DashboardDto? _dashboard;
    private System.Threading.Timer? _timer;
    private DateTime _lastRefresh;
    private int QueueDepth = 0;
    private int PendingJobs = 0;
    private int CompletedJobs = 0;
    private int FailedJobs = 0;
    private int RunCnt = 0;
    private int HungCnt = 0;
    private int SleepCnt = 0;
    private int StopCnt = 0;
    private string runString = string.Empty;
    private string hungString = string.Empty;
    private string sleepString = string.Empty;
    private string stopString = string.Empty;
    #endregion

    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardAsync();

        _timer = new Timer(
            async _ => await RefreshDashboardAsync(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private string GetStatusColor(string State)
    {
        return State.ToUpper().Trim() switch
        {
            "RUNNING" => "limegreen",
            "HUNG" => "gold",
            "STOPPED" => "red",
            "SLEEPING" => "lightskyblue",
            _ => "gray"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private async Task RefreshDashboardAsync()
    {
        var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/dashboard.json?v={DateTime.UtcNow.Ticks}");

        _dashboard = JsonSerializer.Deserialize<DashboardDto>(json);
        
        #region Status Views
        RunCnt = 0;
        HungCnt = 0;
        SleepCnt = 0;
        StopCnt = 0;
        runString = "";
        hungString = "";
        sleepString = "";
        stopString = "";
        #endregion

        if (_dashboard != null)
        {
            foreach (var ds in _dashboard.Services)
            {
                string calcState = DateTime.UtcNow - ds.HeartbeatDT < TimeSpan.FromMinutes(10)
                                    ? ds.State
                                    : DateTime.UtcNow - ds.HeartbeatDT < TimeSpan.FromMinutes(11)
                                    ? "Hung"
                                    : "Stopped";
                if (ds.Service == "MorningMeetingService")
                {
                    if (ds.State != "Stopped" && calcState == "Stopped")
                    {
                        calcState = DateTime.UtcNow - ds.HeartbeatDT < TimeSpan.FromHours(24)
                                    ? "Sleeping"
                                    : "Stopped";
                    }
                }

                ds.State = calcState;
                switch(ds.State)
                {
                    case "Running":
                        RunCnt++;
                        break;
                    case "Hung":
                        HungCnt++;
                        hungString += ds.Service + ": Previous Heartbeat... " + ds.HeartbeatDT.ToString("HH:mm:ss") + "\n";
                        break;
                    case "Sleeping":
                        SleepCnt++;
                        sleepString += ds.Service + ": Previous Heartbeat... " + ds.HeartbeatDT.ToString("HH:mm:ss") + "\n";
                        break;
                    case "Stopped":
                        StopCnt++;
                        stopString += ds.Service + ": Previous Heartbeat... " + ds.HeartbeatDT.ToString("HH:mm:ss") + "\n";
                        break;
                }
            }

            PendingJobs = _dashboard.PendingQueue;
            CompletedJobs = _dashboard.CompletedQueue;
            FailedJobs = _dashboard.FailedQueue;
        }

        _lastRefresh = DateTime.Now;

        await InvokeAsync(StateHasChanged);
    }

    #region Modal Stuff
    private JobRequest NewJob = new()
    {
        RetryCnt = 0,
        NotificationRequired = false
    };
    private string authToken = "";

    private bool ShowRequestJobModal = false;
    private string SelectedJobType = "";

    private List<string> JobTypes = new()
    {
        "ServiceRestart",
        "ProcessCoil",
        "GenerateReport",
        "TrainModel"
    };

    private void CloseModal()
    {
        ShowRequestJobModal = false;

        NewJob = new JobRequest
        {
            RetryCnt = 0,
            NotificationRequired = false
        };
    }

    private async Task SubmitJob()
    {
        var retryCnt = NewJob.RetryCnt;
        var notificationRequired = NewJob.NotificationRequired;
        var job = new JobRequest
        {
            JobType = $"{SelectedJobType}",
            JobName = $"{NewJob.JobName}",
            RunTime = DateTime.Now,
            RetryCnt = retryCnt,
            FromService = "CoilMonitorWeb",
            NotificationRequired = notificationRequired,
            AuthTokenHash = HashHelper.ComputeSha256(authToken)
        };

        string mailto = await RequestService.CreateEmailRequest(job);
        await JS.InvokeVoidAsync(identifier: "open", mailto);

        CloseModal();

        @* await LoadJobs(); *@
    }
    #endregion

}