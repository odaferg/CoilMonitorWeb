@page "/"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Components

@inject HttpClient Http
@implements IDisposable

<div class="dashboard">
    <h1>Coil Monitor</h1>

    @if (_dashboard == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @foreach (var service in _dashboard.Services.OrderBy(s => s.Service))
        {
            <div class="dashboard-card">

                <h2>@service.Service</h2>

                @if (service.State == "Running")
                {
                    <RunningHeartbeat />
                }
                else if (service.State == "Hung")
                {
                    <HungHeartbeat />
                }
                else
                {
                    <StoppedHeartbeat />
                }

                <p>
                    <strong>Status:</strong>
                    <span style="color:@GetStatusColor(service.State)">
                        @service.State
                    </span>
                </p>

                <p>
                    <strong>Heartbeat:</strong>
                    @* @service.HeartbeatDT *@
                    @service.HeartbeatDT.ToLocalTime().ToString("T")
                </p>

            </div>
        }

        <div class="dashboard-card">

            <h2>@QueueWorkerHeader</h2>

            @if (QueueWorkerStatus == "Running")
            {
                <RunningHeartbeat />
            }
            else if (QueueWorkerStatus == "Hung")
            {
                <HungHeartbeat />
            }
            else
            {
                <StoppedHeartbeat />
            }

            <p>
                <strong>Status:</strong>
                <span class="@QueueWorkerStatus.ToLower()">
                    @QueueWorkerStatus
                </span>
            </p>

            <p>
                <strong>Heartbeat:</strong>
                @QueueWorkerHeartbeatText
            </p>

            <p>
                <strong>Queue Depth:</strong>
                @QueueDepth
            </p>

        </div>
    }
</div>

@code
{
    private DashboardDto? _dashboard;
    private System.Threading.Timer? _timer;
    private DateTime _lastRefresh;
    private string QueueWorkerHeader = "Queue Worker Service";
    private string QueueWorkerStatus = "";
    private string QueueWorkerHeartbeatText = "";
    private int QueueDepth = 0;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardAsync();

        _timer = new Timer(
            async _ => await RefreshDashboardAsync(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private string GetStatusColor(string State)
    {
        return State.ToUpper().Trim() switch
        {
            "RUNNING" => "limegreen",
            "HUNG" => "gold",
            "STOPPED" => "red",
            _ => "gray"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private async Task RefreshDashboardAsync()
    {
        var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/dashboard.json?v={DateTime.UtcNow.Ticks}");

        _dashboard = JsonSerializer.Deserialize<DashboardDto>(json);

        if (_dashboard != null)
        {
            var service = _dashboard.Services[0];
            string calculatedState =
                DateTime.UtcNow - service.HeartbeatDT < TimeSpan.FromMinutes(2)
                ? "Running"
                : DateTime.UtcNow - service.HeartbeatDT < TimeSpan.FromMinutes(5)
                    ? "Hung"
                    : "Stopped";

            QueueWorkerStatus = calculatedState;

            QueueWorkerHeartbeatText = $"{DateTime.Now:T}";

            QueueDepth = _dashboard.QueueDepth;
        }
        else
        {
            QueueWorkerStatus = "Stopped";
            QueueWorkerHeartbeatText = $"{DateTime.Now:T}";
        }

        _lastRefresh = DateTime.Now;

        await InvokeAsync(StateHasChanged);
    }
}