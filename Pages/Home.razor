@page "/"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Components
@using CoilMonitorWeb.Helpers

@inject HttpClient Http
@implements IDisposable
@inject IJSRuntime JS
@inject RequestService RequestService

<div class="dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="mb-0"> NCW Web (Mobile)  </h1>

    </div>
    <div class="line-status-container">
        @if (_lineStatus?.Any() == true)
        {
            @foreach (var line in _lineStatus)
            {
                <div class="line-status">
                    <span>@line.Line</span>
                    @if (line.Status == "R")
                    {
                        <i class="fa-solid fa-circle-check status-green"></i>
                    }
                    else if (line.Status == "S")
                    {
                        <i class="fa-solid fa-triangle-exclamation status-yellow"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-xmark status-red" @onclick="() => ShowDelay(line)"></i>
                    }
                    
                </div>
            }
        }
    </div>
    <br /><br />
    <b>Daily Performance Through: @dailyPerformanceDT</b>
    @* <pre>@_rawJson</pre> *@
    <div class="production-dashboard">
        @if (_homepage?.Tables?.Any() == true)
        {
            <div class="table-responsive">
                @foreach (var table in _homepage.Tables)
                {
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>@table.Title</th>
                                <th>Day</th>
                                <th>WTD</th>
                                <th>MTD</th>
                                <th>YTD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in table.PRows)
                            {
                                <tr>
                                    <td>@row.Title</td>
                                    <td class="@row.Day.Style">@FormatValue(row.Day)</td>
                                    <td class="@row.WeekToDate.Style">@FormatValue(row.WeekToDate)</td>
                                    <td class="@row.MonthToDate.Style">@FormatValue(row.MonthToDate)</td>
                                    <td class="@row.YearToDate.Style">@FormatValue(row.YearToDate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <br/>
                }
            </div>
        }
        else
        {
            <h1 class="mb-0">Loading...</h1>
        }
    </div>
</div>
@if (ShowDelayPopup && SelectedLine != null)
{
    <div class="popup-overlay" @onclick="CloseDelay">

        <div class="popup-card" @onclick:stopPropagation="true">

            <h4>@SelectedLine.Line</h4>

            <p>
                <strong>Status:</strong>
                @SelectedLine.Status
            </p>

            <p>
                <strong>Reason:</strong>
                @SelectedLine.Reason @SelectedLine.Comments
            </p>

            <p>
                <strong>Started:</strong>
                <b>Production Delay </b> started at @SelectedLine.StartTime.ToString("MM/dd HH:mm")
            </p>

            <p>
                <strong>Estimated End Time:</strong>
                @if(SelectedLine.EstimatedEndTime.Year != DateTime.MinValue.Year)
                {
                    @SelectedLine.EstimatedEndTime.ToString("MM/dd HH:mm")
                }
                
            </p>

            <button @onclick="CloseDelay">
                Close
            </button>

        </div>

    </div>
}

@code
{
    #region Variables
    private DailySummaryTwo? _dashboard;
    private DailySummary? _homepage;
    private List<LineStatusDto>? _lineStatus;
    private System.Threading.Timer? _timer;
    private DateTime _lastRefresh;
    string tempDelayReason = "This is just a temp holder";
    DateTime tempDelayDT = DateTime.Now.AddDays(-3);
    private LineStatusDto? SelectedLine;
    private bool ShowDelayPopup = false;
    private string dailyPerformanceDT = "";
    #endregion
    string _rawJson = "Blank";
    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardAsync();

        _timer = new Timer(
            async _ => await RefreshDashboardAsync(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private string GetStatusColor(string State)
    {
        return State.ToUpper().Trim() switch
        {
            "RUNNING" => "limegreen",
            "HUNG" => "gold",
            "STOPPED" => "red",
            "SLEEPING" => "lightskyblue",
            _ => "gray"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private async Task RefreshDashboardAsync()
    {
        dailyPerformanceDT = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd");
        #region Load Line Status
        var lineJson = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/linestatus.json?v={DateTime.UtcNow.Ticks}");
        #endregion
        @* var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/dailysummary.json?v={DateTime.UtcNow.Ticks}"); *@
        var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/homepage.json?v={DateTime.UtcNow.Ticks}");

        _lineStatus = JsonSerializer.Deserialize<List<LineStatusDto>>(lineJson);
        @* _dashboard = JsonSerializer.Deserialize<DailySummaryTwo>(json); *@
        _homepage = JsonSerializer.Deserialize<DailySummary>(json);
        _rawJson = json;

        _lastRefresh = DateTime.Now;

        await InvokeAsync(StateHasChanged);
    }

    private string FormatValue(DailySummaryValue value)
    {
        if (!value.IsValid)
            return "";

        return value.Value.ToString($"N{value.SignificantDigits}");
    }

    private void ShowDelay(LineStatusDto line)
    {
        SelectedLine = line;
        ShowDelayPopup = true;
    }

    private void CloseDelay()
    {
        ShowDelayPopup = false;
        SelectedLine = null;
    }

}