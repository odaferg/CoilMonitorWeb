@page "/"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Components
@using CoilMonitorWeb.Helpers

@inject HttpClient Http
@implements IDisposable
@inject IJSRuntime JS
@inject RequestService RequestService

<div class="dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="mb-0"> Home Page Dashboard </h1>

    </div>
    <div class="line-status-container">
        @if (_lineStatus?.Any() == true)
        {
            @foreach (var line in _lineStatus)
            {
                <div class="line-status">
                    <span>@line.Line</span>
                    <i
                    class="@(line.Status == "Running" ? "fa-solid fa-circle-check status-green" : "fa-solid fa-circle-xmark status-red")"></i>
                </div>
            }
        }
    </div>
    <br /><br />
    @* <pre>@_rawJson</pre> *@
    @if (_dashboard?.DailyInfo?.Any() == true)
    {
        <div class="table-responsive">
            <table class="status-table">
                <thead>
                    <tr>
                        <th>@_dashboard.SnapShotDate</th>
                        <th>Day</th>
                        <th>vs S&OP</th>
                        <th>Working Ratio</th>
                        <th>Efficiency</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _dashboard.DailyInfo)
                    {
                        <tr>
                            <td>@item.Line.Replace("K", "")</td>
                            <td class="@(item.SOP < 0 ? "negative-value" : "positive-value")">@item.Day</td>
                            <td class="@(item.SOP < 0 ? "negative-value" : "positive-value")">@item.SOP</td>
                            <td>@item.WorkingRatio</td>
                            <td>@item.Efficiency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <h1 class="mb-0">Loading...</h1>
    }
</div>

@code
{
    #region Variables
    private DailySummary? _dashboard;
    private List<LineStatusDto>? _lineStatus;
    private System.Threading.Timer? _timer;
    private DateTime _lastRefresh;
    #endregion
    string _rawJson = "Blank";
    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardAsync();

        _timer = new Timer(
            async _ => await RefreshDashboardAsync(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private string GetStatusColor(string State)
    {
        return State.ToUpper().Trim() switch
        {
            "RUNNING" => "limegreen",
            "HUNG" => "gold",
            "STOPPED" => "red",
            "SLEEPING" => "lightskyblue",
            _ => "gray"
        };
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private async Task RefreshDashboardAsync()
    {
        #region Load Line Status
        @* _lineStatus = new List<LineStatusDto>
        {
            new() { Line = "CDCM", Status = "Stopped" },
            new() { Line = "CAPL", Status = "Stopped" },
            new() { Line = "TIL1", Status = "Stopped" },
            new() { Line = "CGL", Status = "Running" },
            new() { Line = "EGL", Status = "Running" },
            new() { Line = "KIL1", Status = "Running" },
            new() { Line = "KIL2", Status = "Running" },
        }; *@
        var lineJson = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/linestatus.json?v={DateTime.UtcNow.Ticks}");
        #endregion
        var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/dailysummary.json?v={DateTime.UtcNow.Ticks}");

        _lineStatus = JsonSerializer.Deserialize<List<LineStatusDto>>(lineJson);
        _dashboard = JsonSerializer.Deserialize<DailySummary>(json);
        _rawJson = json;

        _lastRefresh = DateTime.Now;

        await InvokeAsync(StateHasChanged);
    }

}