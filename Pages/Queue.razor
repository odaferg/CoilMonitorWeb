@page "/queue"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Helpers
@inject RequestService RequestService
@inject HttpClient Http

<h3>Queue</h3>

@if (queueItems == null)
{
    <p>Loading...</p>
}
else if (!queueItems.Any())
{
    <p>No coils currently queued.</p>
}
else
{
    <div class="queue-page">

        @foreach (var item in queueItems)
        {
            <div class="queue-card">
                <h4>@item.CoilNumber</h4>

                <div class="time">
                    Queued: @item.QueuedTime
                </div>

                <div class="time">
                    Scheduled: @item.RunTime
                </div>
            </div>
        }

        @if (showPinDialog)
        {
            <div class="modal-overlay">
                <div style="
                    background:#1e1e1e;
                    color:white;
                    width:400px;
                    height:300px;
                    z-index:99999;
                    padding:20px;
                    border: 1px solid #404040;
                    box-shadow: 0 10px 30px rgba(0,0,0,.5);">

                    <h3>Force Process</h3>

                    <p>Coil: @selectedCoilNumber</p>

                    <input style="
                            width: 100%;
                            padding: 8px;
                            margin-top: 12px;
                            margin-bottom: 16px;
                            border: 1px solid #555;
                            background: #2b2b2b;
                            color: white;" 
                            type="password" @bind="authToken" />

                    <br /><br />

                    <button @onclick="CloseDialog">
                        Cancel
                    </button>

                    <button @onclick="SubmitForceProcess">
                        Submit
                    </button>

                </div>
            </div>
        }

    </div>
}

@code {
    private List<QueuedCoilDto>? queueItems;
    private Timer? timer;
    private bool showPinDialog;

    private string authToken = "";

    private string selectedCoilNumber = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadQueue();

        timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadQueue();
                StateHasChanged();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private async Task LoadQueue()
    {
        queueItems = await Http.GetFromJsonAsync<List<QueuedCoilDto>>(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/queuelist.json?v={DateTime.UtcNow.Ticks}");

        queueItems = queueItems!
                    .OrderBy(x => x.RunTime)
                    .ToList();
    }

    private void ShowForceProcessDialog(string coilNumber)
    {
        selectedCoilNumber = coilNumber;
        authToken = "";
        showPinDialog = true;
    }

    private void CloseDialog()
    {
        showPinDialog = false;
        authToken = "";
        selectedCoilNumber = "";
    }

    private async Task SubmitForceProcess()
    {
        var request = new CommandRequest
        {
            RequestId = Guid.NewGuid().ToString(),

            JobType = "ForceProcess",

            AuthTokenHash = HashHelper.ComputeSha256(authToken),

            Status = RequestStatus.Pending,

            CreatedAt = DateTime.UtcNow,

            Parameters = new()
            {
                ["CoilNumber"] = selectedCoilNumber
            }
        };

        await RequestService.CreateRequest(request);

        showPinDialog = false;
    }
}