@page "/queue"
@using System.Text.Json
@using CoilMonitorWeb.Models
@using CoilMonitorWeb.Helpers
@inject IJSRuntime JS
@inject RequestService RequestService
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Queue</h3>

    <button class="btn btn-primary"
            @onclick="(() => ShowRequestJobModal = true)">
        Request Job
    </button>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-dark text-white border-secondary">
            <div class="card-header text-center">Pending</div>
            <div class="card-body text-center">
                @* <h2>@PendingJobs.Count</h2> *@
                <h2 class="text-warning">@PendingJobs</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-dark text-white border-secondary">
            <div class="card-header text-center">Completed</div>
            <div class="card-body text-center">
                @* <h2>@CompletedJobs.Count</h2> *@
                <h2 class="text-success">@CompletedJobs</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-dark text-white border-secondary">
            <div class="card-header text-center">Failed</div>
            <div class="card-body text-center">
                <h2 class="text-danger">@FailedJobs</h2>
            </div>
        </div>
    </div>
</div>

@if (ShowRequestJobModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Request Job</h5>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Job Type</label>

                        <InputSelect class="form-select" @bind-Value="SelectedJobType">
                            <option value="">Select Job Type</option>

                            @foreach (var jobType in JobTypes)
                            {
                                <option value="@jobType">@jobType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Job Name</label>

                        <InputText class="form-control" @bind-Value="NewJob.JobName" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Retry Count</label>

                        <InputNumber class="form-control" @bind-Value="NewJob.RetryCnt" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Notification Required
                        </label>

                        <InputSelect class="form-select" @bind-Value="NewJob.NotificationRequired">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </InputSelect>
                    </div>

                    <input style="
                            width: 100%;
                            padding: 8px;
                            margin-top: 12px;
                            margin-bottom: 16px;
                            border: 1px solid #555;
                            background: #2b2b2b;
                            color: white;" 
                            type="password" @bind="authToken" />

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">
                        Cancel
                    </button>

                    <button class="btn btn-primary" @onclick="SubmitJob">
                        Submit
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private List<QueuedCoilDto>? queueItems;
    private DashboardDto? queueInfo;
    private Timer? timer;
    private bool showPinDialog;

    private string authToken = "";

    private string selectedCoilNumber = "";
    private int PendingJobs = 0;
    private int CompletedJobs = 0;
    private int FailedJobs = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueue();

        timer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadQueue();
                StateHasChanged();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private async Task LoadQueue()
    {
        var json = await Http.GetStringAsync(
            $"https://gist.githubusercontent.com/odaferg/632d5e2a1f95e88e6d8d1bb42ddaca5d/raw/dashboard.json?v={DateTime.UtcNow.Ticks}"
        );

        queueInfo = JsonSerializer.Deserialize<DashboardDto>(json);

        if (queueInfo != null)
        {
            PendingJobs = queueInfo.PendingQueue;
            CompletedJobs = queueInfo.CompletedQueue;
            FailedJobs = queueInfo.FailedQueue;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ShowForceProcessDialog(string coilNumber)
    {
        selectedCoilNumber = coilNumber;
        authToken = "";
        showPinDialog = true;
    }

    private void CloseDialog()
    {
        showPinDialog = false;
        authToken = "";
        selectedCoilNumber = "";
    }

    private async Task SubmitForceProcess()
    {
        var request = new CommandRequest
        {
            RequestId = Guid.NewGuid().ToString(),

            JobType = "ForceProcess",

            AuthTokenHash = HashHelper.ComputeSha256(authToken),

            Status = RequestStatus.Pending,

            CreatedAt = DateTime.UtcNow,

            Parameters = new()
            {
                ["CoilNumber"] = selectedCoilNumber
            }
        };

        //await RequestService.CreateRequest(request);
        string mailto = await RequestService.CreateEmailRequest(request);
        await JS.InvokeVoidAsync("open", mailto);

        showPinDialog = false;
    }

    private JobRequest NewJob = new()
    {
        RetryCnt = 0,
        NotificationRequired = false
    };

    private bool ShowRequestJobModal = false;
    private string SelectedJobType = "";

    private List<string> JobTypes = new()
    {
        "ServiceRestart",
        "ProcessCoil",
        "GenerateReport",
        "TrainModel"
    };

    private void CloseModal()
    {
        ShowRequestJobModal = false;

        NewJob = new JobRequest
        {
            RetryCnt = 0,
            NotificationRequired = false
        };
    }

    private async Task SubmitJob()
    {
        var retryCnt = NewJob.RetryCnt;
        var notificationRequired = NewJob.NotificationRequired;
        var job = new JobRequest
        {
            JobType = $"{SelectedJobType}",
            JobName = $"{NewJob.JobName}",
            RunTime = DateTime.Now,
            RetryCnt = retryCnt,
            FromService = "CoilMonitorWeb",
            NotificationRequired = notificationRequired,
            AuthTokenHash = HashHelper.ComputeSha256(authToken)
        };

        string mailto = await RequestService.CreateEmailRequest(job);
        await JS.InvokeVoidAsync(identifier:"open", mailto);

        CloseModal();

        @* await LoadJobs(); *@
    }
}